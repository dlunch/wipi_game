# NPC 데이터
# 포맷: id:name:type:dialog_id[:shop_id]
# type: V=Villager, S=ShopKeeper, Q=QuestGiver, H=Healer
# 좌표/맵 배치는 maps.dat 의 @NPC:x:y:npc_id 에서 관리

# 마을 NPC (40x20 맵)
elder:마을 장로:Q:dialog_elder
shopkeeper:무기상인:S:dialog_shop:weapon_shop
healer:치료사:H:dialog_healer
villager1:농부:V:dialog_villager

# 성 NPC (40x20 맵)
guard:성문 경비병:Q:dialog_guard
# 확장 지역 NPC
ranger:고원 순찰대:Q:dialog_ranger
highland_merchant:원정 상인:S:dialog_highland_shop:highland_shop
archaeologist:고고학자:Q:dialog_archaeologist
swamp_guide:늪지 안내인:V:dialog_swamp_guide
